# assets/, langs templates, CNAME, manifest.webmanifest, llms.txt
site/data/
data/collect-plan/
site/repos/
site/langs/
site/tags/
site/b/
site-data.db*
site/sitemap.xml
site/feed.xml
site/robots.txt

# one-off discoverhub.cn archive scrape — script + data, never committed
docs/discoverhub/
