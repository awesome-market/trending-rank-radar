{"full_name":"zhoutaoo/SpringCloud","owner":"zhoutaoo","name":"SpringCloud","url":"https://github.com/zhoutaoo/SpringCloud","description":"Opensabre是基于SpringCloud2023的微服务开发平台，整合了Spring Security、Springcloud Alibaba等组件。  包含了基础的RBAC权限管理、授权认证、网关管理、服务治理、审计日志等系统管理基础应用。  定义了相关开发规范、风格并落地在服务框架层，开箱即用，支持Docker、Kubenetes的部署。  让项目开发人员快速进入业务开发，而不需过多时间花费在基础架构搭建和编码风格规范上。  目标是建立一套金融级、高安全性的微服务解决方案。","homepage":"","topics":["springcloud","springboot","oauth2","feign-client","spring-cloud-gateway","spring-security","nacos","sentinel","jetcache","skywalking"],"tag_pages":[],"language":null,"license":"Apache-2.0","avatar":"https://avatars.githubusercontent.com/u/3946731?u=5cc2e67a1bae7f3f0da643234a364404f3717b66&v=4","created_at":"2017-07-23T14:28:08Z","pushed_at":"2026-09-19T15:49:07Z","metrics":{"stars":8932,"forks":3822,"watchers":348,"issues":129,"prs":113,"releases":0,"issues_open":0,"issues_closed":129,"prs_open":1,"prs_closed":31,"prs_merged":81,"discussions":0},"growth":{"day":{"stars":0,"forks":0,"base_day":"2026-11-13"}},"history":{"dates":["2026-11-10","2026-11-11","2026-11-12","2026-11-13","2026-11-14"],"stars":[8931,8932,8932,8932,8932],"forks":[3823,3822,3822,3822,3822],"watchers":[null,348,348,348,348],"issues_open":[null,0,0,0,0],"prs_open":[null,1,1,1,1]},"boards":{},"same_owner":[],"issues":[],"discussions":[],"latest_release":null,"readme":false,"readme_zh":false,"news":[],"stale":false,"snapshot_at":"2026-11-14T08:50:43Z","history_start":"2026-09-06"}