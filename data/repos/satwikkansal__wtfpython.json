utions welcome! (corresponding [issues](https://github.com/satwikkansal/wtfpython/issues?q=is%3Aopen+is%3Aissue+label%3Atranslation)).","is_prerelease":false},"readme":true,"readme_zh":false,"news":[],"stale":false,"snapshot_at":"2026-11-14T08:50:43Z","history_start":"2026-09-06"}